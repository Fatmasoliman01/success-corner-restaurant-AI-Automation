        "jsCode": "// Quantity from Google Sheet\nconst sheetQuantity = $input.first().json.quantity;\n\n// Quantity from Parse Message node\nconst chatQuantity = $items(\"Parse Message\")[0].json.quantity;\n\n// Calculate new quantity\nconst newQuantity = sheetQuantity + chatQuantity;\n\nreturn [\n  {\n    json: {\n      item: $input.first().json.item,\n      old_quantity: sheetQuantity,\n      added_quantity: chatQuantity,\n      new_quantity: newQuantity\n    }\n  }\n];"
      },
